# Track the website and its maintenance sources explicitly.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/index.html
!/styles.css
!/site.js
!/favicon-32.png
!/ms-resume.pdf
!/google3e7e3594d3bac0bb.html
!/robots.txt
!/sitemap.xml
!/fonts/
!/images/
/images/*
!/images/optimized/
!/content/
/content/*
!/content/resume.json
!/tools/

# Local artifacts, credentials, caches, and dependencies stay off GitHub.
node_modules/
__pycache__/
*.pyc
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
